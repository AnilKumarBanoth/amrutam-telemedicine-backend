# Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Security Secrets
JWT_SECRET=super-secret-jwt-key-for-amrutam-telemedicine-system-min-32-chars!
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-refresh-key-amrutam-telemedicine-32-chars!
JWT_REFRESH_EXPIRES_IN=7d

# Data Encryption at Rest (AES-256-GCM) - 32 bytes hex encoded key
# Generate via: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_VERSION=v1

# Digital Signatures for Prescriptions (HMAC-SHA256)
PRESCRIPTION_SIGNING_KEY=amrutam-digital-prescription-signing-key-production-grade

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=amrutam_user
DB_PASSWORD=amrutam_secure_password
DB_NAME=amrutam_telemedicine
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_USE_MEMORY_FALLBACK=true

# Redis (Caching & Distributed Lock)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USE_MEMORY_FALLBACK=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Observability
METRICS_PORT=9090
LOG_LEVEL=info
SERVICE_NAME=amrutam-telemedicine-backend
